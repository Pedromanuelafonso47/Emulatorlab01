# Supabase (opcional): projetos na nuvem. Copie para .env.local e preencha com os dados do seu projeto.
# Execute supabase/schema.sql no SQL Editor do Supabase antes de usar.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=CHAVE-ANON-PUBLICA

# Serviço de compilação (Uno, Nano, Mega, Pico). Omita para desenvolvimento local (http://127.0.0.1:8787).
VITE_COMPILE_URL=https://o-seu-servico.exemplo
